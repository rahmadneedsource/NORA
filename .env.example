# ---------------------------------------------------------------------------
# NORA — environment variables
# Copy this file to .env and fill the values locally. Never commit .env.
# ---------------------------------------------------------------------------

APP_ENV=production

# Directory for SQLite, uploads, and generated scan frames.
# In Docker this is mounted as a persistent volume.
DATA_DIR=./data

# Comma-separated list of allowed browser origins (same-origin needs no entry).
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# AI vision provider
# ---------------------------------------------------------------------------
# openai_compatible | anthropic | none
AI_PROVIDER=openai_compatible

# OpenRouter example:
#   AI_BASE_URL=https://openrouter.ai/api/v1
# OpenAI example:
#   AI_BASE_URL=https://api.openai.com/v1
# Local Ollama example:
#   AI_BASE_URL=http://localhost:11434/v1
AI_BASE_URL=https://openrouter.ai/api/v1

# Keep the real key in .env only. Empty = quality-only mode (no AI findings).
AI_API_KEY=

# Must be a vision-capable model.
AI_MODEL=google/gemini-2.5-flash

# OpenRouter optional attribution headers.
AI_APP_NAME=NORA
AI_APP_URL=

AI_TIMEOUT_SECONDS=60
AI_MAX_FRAMES=6
AI_MAX_IMAGE_PX=768

# ---------------------------------------------------------------------------
# Upload limits
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=200
MAX_FILES=20
