# NORA — contoh konfigurasi Caddy 2
#
# 1. Ganti nora.contoh.com dengan domain Anda.
# 2. Salin ke /etc/caddy/Caddyfile.
# 3. sudo systemctl reload caddy
#
# Caddy menerbitkan dan memperbarui sertifikat HTTPS secara otomatis.

nora.contoh.com {
    encode zstd gzip

    # Backend default 200 MB + headroom multipart.
    request_body {
        max_size 210MB
    }

    reverse_proxy 127.0.0.1:8000 {
        # Matikan buffering agar SSE /api/scans/{id}/events langsung terkirim.
        flush_interval -1
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        # Aktifkan HSTS hanya setelah HTTPS dipastikan berjalan.
        # Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
}
